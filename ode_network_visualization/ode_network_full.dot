digraph ODE_Network {
  graph [rankdir=LR, splines=true, overlap=false, compound=true, fontsize=18, fontname=Helvetica, labelloc=t, label="Full ODE-Network Structure of the Fermentation Simulator"];
  node [fontname=Helvetica, fontsize=11, margin=0.08];
  edge [fontname=Helvetica, fontsize=8, arrowsize=0.7];
  subgraph cluster_substrate {
    label="Substrate pools";
    style="rounded";
    color="gray70";
    penwidth=1.0;
    "starch_g_L" [label="Starch", shape=ellipse, style="rounded,filled", fillcolor="white", penwidth=1.4];
    "dextrin_g_L" [label="Dextrin", shape=ellipse, style="rounded,filled", fillcolor="white", penwidth=1.4];
    "protein_g_L" [label="Protein", shape=ellipse, style="rounded,filled", fillcolor="white", penwidth=1.4];
    "maltose_g_L" [label="Maltose", shape=ellipse, style="rounded,filled", fillcolor="white", penwidth=1.4];
    "maltotriose_g_L" [label="Maltotriose", shape=ellipse, style="rounded,filled", fillcolor="white", penwidth=1.4];
    "glucose_g_L" [label="Glucose", shape=ellipse, style="rounded,filled", fillcolor="white", penwidth=1.4];
    "fructose_g_L" [label="Fructose", shape=ellipse, style="rounded,filled", fillcolor="white", penwidth=1.4];
    "fermentable_sugar_pool" [label="Fermentable sugar pool", shape=box, style="rounded,filled", fillcolor="gray96", penwidth=1.1];
  }
  subgraph cluster_enzyme {
    label="Enzymatic module";
    style="rounded";
    color="gray70";
    penwidth=1.0;
    "enzyme_activity_factor" [label="Enzyme activity", shape=box, style="rounded,filled", fillcolor="gray96", penwidth=1.1];
  }
  subgraph cluster_environment {
    label="Environment";
    style="rounded";
    color="gray70";
    penwidth=1.0;
    "temperature_C" [label="Temperature", shape=box, style="rounded,filled", fillcolor="gray96", penwidth=1.1];
    "pH" [label="pH", shape=box, style="rounded,filled", fillcolor="gray96", penwidth=1.1];
    "nitrogen_g_L" [label="Assimilable N", shape=ellipse, style="rounded,filled", fillcolor="white", penwidth=1.4];
    "oxygen_mg_L" [label="Dissolved O₂", shape=ellipse, style="rounded,filled", fillcolor="white", penwidth=1.4];
    "environment_oxygen" [label="External O₂", shape=house, style="filled", fillcolor="gray95", penwidth=1.1];
  }
  subgraph cluster_yeast {
    label="Yeast physiology / fluxes";
    style="rounded";
    color="gray70";
    penwidth=1.0;
    "biomass_g_L" [label="Yeast biomass", shape=ellipse, style="rounded,filled", fillcolor="white", penwidth=1.4];
    "activity" [label="Yeast activity", shape=box, style="rounded,filled", fillcolor="gray96", penwidth=1.1];
    "stress" [label="Stress index", shape=box, style="rounded,filled", fillcolor="gray96", penwidth=1.1];
    "aerobic_fraction" [label="Aerobic fraction", shape=box, style="rounded,filled", fillcolor="gray96", penwidth=1.1];
    "fermentative_fraction" [label="Fermentative fraction", shape=box, style="rounded,filled", fillcolor="gray96", penwidth=1.1];
    "sugar_uptake_flux" [label="Sugar uptake flux", shape=diamond, style="filled", fillcolor="gray92", penwidth=1.2];
    "growth_flux" [label="Growth flux", shape=diamond, style="filled", fillcolor="gray92", penwidth=1.2];
    "death_flux" [label="Death flux", shape=diamond, style="filled", fillcolor="gray92", penwidth=1.2];
  }
  subgraph cluster_products {
    label="Products and feedback";
    style="rounded";
    color="gray70";
    penwidth=1.0;
    "ethanol_g_L" [label="Ethanol", shape=ellipse, style="rounded,filled", fillcolor="white", penwidth=1.4];
    "co2_g_L" [label="CO₂", shape=ellipse, style="rounded,filled", fillcolor="white", penwidth=1.4];
    "retained_co2_g_L" [label="Retained CO₂", shape=ellipse, style="rounded,filled", fillcolor="white", penwidth=1.4];
    "glycerol_g_L" [label="Glycerol", shape=ellipse, style="rounded,filled", fillcolor="white", penwidth=1.4];
    "acetate_g_L" [label="Acetate", shape=ellipse, style="rounded,filled", fillcolor="white", penwidth=1.4];
    "acid_mM" [label="Organic acid", shape=ellipse, style="rounded,filled", fillcolor="white", penwidth=1.4];
    "gas_retention_flux" [label="Gas retention", shape=diamond, style="filled", fillcolor="gray92", penwidth=1.2];
    "ethanol_evaporation_sink" [label="Ethanol loss", shape=invhouse, style="filled", fillcolor="gray95", penwidth=1.1];
    "co2_escape_sink" [label="CO₂ escape", shape=invhouse, style="filled", fillcolor="gray95", penwidth=1.1];
  }
  subgraph cluster_other {
    label="Other";
    style="rounded";
    color="gray70";
    penwidth=1.0;
    "oxygen_transfer_flux" [label="O₂ transfer flux", shape=diamond, style="filled", fillcolor="gray92", penwidth=1.2];
  }
  "temperature_C" -> "enzyme_activity_factor" [style="dotted", arrowhead="normal", penwidth=1.1, label="enzyme temp factor"];
  "pH" -> "enzyme_activity_factor" [style="dotted", arrowhead="normal", penwidth=1.1, label="enzyme pH factor"];
  "enzyme_activity_factor" -> "starch_g_L" [style="dashed", arrowhead="tee", penwidth=1.1, label="starch hydrolysis"];
  "enzyme_activity_factor" -> "dextrin_g_L" [style="dotted", arrowhead="normal", penwidth=1.1, label="dextrin hydrolysis"];
  "enzyme_activity_factor" -> "protein_g_L" [style="dashed", arrowhead="tee", penwidth=1.1, label="proteolysis"];
  "starch_g_L" -> "dextrin_g_L" [style="solid", arrowhead="normal", penwidth=1.1, label="starch→dextrin"];
  "dextrin_g_L" -> "maltose_g_L" [style="solid", arrowhead="normal", penwidth=1.1, label="dextrin→maltose"];
  "maltose_g_L" -> "glucose_g_L" [style="solid", arrowhead="normal", penwidth=1.1, label="maltose→glucose"];
  "maltotriose_g_L" -> "glucose_g_L" [style="solid", arrowhead="normal", penwidth=1.1, label="maltotriose→glucose"];
  "protein_g_L" -> "nitrogen_g_L" [style="solid", arrowhead="normal", penwidth=1.1, label="protein→N"];
  "maltose_g_L" -> "fermentable_sugar_pool" [style="solid", arrowhead="normal", style="dotted", penwidth=1.1, label="pool"];
  "maltose_g_L" -> "sugar_uptake_flux" [style="dashed", arrowhead="tee", penwidth=1.1, label="uptake share"];
  "maltotriose_g_L" -> "fermentable_sugar_pool" [style="solid", arrowhead="normal", style="dotted", penwidth=1.1, label="pool"];
  "maltotriose_g_L" -> "sugar_uptake_flux" [style="dashed", arrowhead="tee", penwidth=1.1, label="uptake share"];
  "glucose_g_L" -> "fermentable_sugar_pool" [style="solid", arrowhead="normal", style="dotted", penwidth=1.1, label="pool"];
  "glucose_g_L" -> "sugar_uptake_flux" [style="dashed", arrowhead="tee", penwidth=1.1, label="uptake share"];
  "fructose_g_L" -> "fermentable_sugar_pool" [style="solid", arrowhead="normal", style="dotted", penwidth=1.1, label="pool"];
  "fructose_g_L" -> "sugar_uptake_flux" [style="dashed", arrowhead="tee", penwidth=1.1, label="uptake share"];
  "glucose_g_L" -> "maltose_g_L" [style="dashed", arrowhead="tee", penwidth=1.1, label="glucose repression"];
  "glucose_g_L" -> "maltotriose_g_L" [style="dashed", arrowhead="tee", penwidth=1.1, label="glucose repression"];
  "fermentable_sugar_pool" -> "activity" [style="solid", arrowhead="normal", penwidth=1.1, label="sugar limitation"];
  "nitrogen_g_L" -> "activity" [style="solid", arrowhead="normal", penwidth=1.1, label="N limitation"];
  "ethanol_g_L" -> "activity" [style="dashed", arrowhead="tee", penwidth=1.1, label="ethanol inhibition"];
  "temperature_C" -> "activity" [style="dotted", arrowhead="normal", penwidth=1.1, label="temp factor"];
  "pH" -> "activity" [style="dotted", arrowhead="normal", penwidth=1.1, label="pH factor"];
  "oxygen_mg_L" -> "aerobic_fraction" [style="solid", arrowhead="normal", penwidth=1.1, label="O₂ availability"];
  "oxygen_mg_L" -> "fermentative_fraction" [style="dashed", arrowhead="tee", penwidth=1.1, label="low-O₂ fermentation"];
  "fermentable_sugar_pool" -> "fermentative_fraction" [style="solid", arrowhead="normal", penwidth=1.1, label="Crabtree effect"];
  "temperature_C" -> "stress" [style="dotted", arrowhead="normal", penwidth=1.1, label="thermal stress"];
  "pH" -> "stress" [style="dotted", arrowhead="normal", penwidth=1.1, label="pH stress"];
  "ethanol_g_L" -> "stress" [style="solid", arrowhead="normal", penwidth=1.1, label="ethanol stress"];
  "fermentable_sugar_pool" -> "stress" [style="solid", arrowhead="normal", penwidth=1.1, label="osmotic stress"];
  "biomass_g_L" -> "sugar_uptake_flux" [style="solid", arrowhead="normal", penwidth=1.1, label="biomass term"];
  "activity" -> "sugar_uptake_flux" [style="solid", arrowhead="normal", penwidth=1.1, label="q_s activity"];
  "sugar_uptake_flux" -> "growth_flux" [style="solid", arrowhead="normal", penwidth=1.1, label="Yx/s"];
  "aerobic_fraction" -> "growth_flux" [style="solid", arrowhead="normal", penwidth=1.1, label="aerobic yield"];
  "growth_flux" -> "biomass_g_L" [style="solid", arrowhead="normal", penwidth=1.1, label="growth"];
  "stress" -> "death_flux" [style="solid", arrowhead="normal", penwidth=1.1, label="stress death"];
  "biomass_g_L" -> "death_flux" [style="solid", arrowhead="normal", penwidth=1.1, label="death term"];
  "death_flux" -> "biomass_g_L" [style="dashed", arrowhead="tee", penwidth=1.1, label="death"];
  "growth_flux" -> "nitrogen_g_L" [style="dashed", arrowhead="tee", penwidth=1.1, label="N assimilation"];
  "sugar_uptake_flux" -> "oxygen_mg_L" [style="dashed", arrowhead="tee", penwidth=1.1, label="aerobic O₂ use"];
  "aerobic_fraction" -> "oxygen_mg_L" [style="dashed", arrowhead="tee", penwidth=1.1, label="aerobic O₂ demand"];
  "sugar_uptake_flux" -> "ethanol_g_L" [style="solid", arrowhead="normal", penwidth=1.1, label="ethanol yield"];
  "fermentative_fraction" -> "ethanol_g_L" [style="solid", arrowhead="normal", penwidth=1.1, label="fermentative yield"];
  "sugar_uptake_flux" -> "co2_g_L" [style="solid", arrowhead="normal", penwidth=1.1, label="CO₂ yield"];
  "fermentative_fraction" -> "co2_g_L" [style="solid", arrowhead="normal", penwidth=1.1, label="fermentative CO₂"];
  "sugar_uptake_flux" -> "glycerol_g_L" [style="solid", arrowhead="normal", penwidth=1.1, label="glycerol yield"];
  "stress" -> "glycerol_g_L" [style="solid", arrowhead="normal", penwidth=1.1, label="stress glycerol"];
  "sugar_uptake_flux" -> "acetate_g_L" [style="solid", arrowhead="normal", penwidth=1.1, label="acetate yield"];
  "aerobic_fraction" -> "acetate_g_L" [style="solid", arrowhead="normal", penwidth=1.1, label="aerobic acetate"];
  "sugar_uptake_flux" -> "acid_mM" [style="solid", arrowhead="normal", penwidth=1.1, label="acidification"];
  "acetate_g_L" -> "acid_mM" [style="solid", arrowhead="normal", penwidth=1.1, label="acetate acidity"];
  "environment_oxygen" -> "oxygen_transfer_flux" [style="solid", arrowhead="normal", penwidth=1.1, label="kLa transfer"];
  "oxygen_transfer_flux" -> "oxygen_mg_L" [style="solid", arrowhead="normal", penwidth=1.1, label="O₂ transfer"];
  "acid_mM" -> "pH" [style="dashed", arrowhead="tee", penwidth=1.1, label="buffered acidification"];
  "co2_g_L" -> "gas_retention_flux" [style="solid", arrowhead="normal", penwidth=1.1, label="retention fraction"];
  "gas_retention_flux" -> "retained_co2_g_L" [style="solid", arrowhead="normal", penwidth=1.1, label="retained CO₂"];
  "retained_co2_g_L" -> "co2_escape_sink" [style="dashed", arrowhead="tee", penwidth=1.1, label="CO₂ escape"];
  "ethanol_g_L" -> "ethanol_evaporation_sink" [style="dashed", arrowhead="tee", penwidth=1.1, label="evaporation"];
}
